# ────────────────────────────────────────────────────────────────
# Restoran buyurtma tizimi — Backend muhit o'zgaruvchilari
# Ushbu faylni .env deb nusxalang va qiymatlarni to'ldiring.
# .env HECH QACHON git repoga qo'yilmaydi (.gitignore'da).
# ────────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Ma'lumotlar bazasi (PostgreSQL)
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant?schema=public"

# Redis (BullMQ navbati uchun)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Navbat backend: "redis" (production, BullMQ) | "memory" (dev, Redis'siz tez sinov)
QUEUE_BACKEND=redis

# Telegram bot
# BotFather (https://t.me/BotFather) dan olingan token
TELEGRAM_BOT_TOKEN=
# Restoran egasining chat ID si (https://t.me/userinfobot yordamida bilib oling)
TELEGRAM_ADMIN_CHAT_ID=
# Production: https domenli webhook URL, masalan https://api.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Development: true bo'lsa long-polling ishlaydi (webhook shart emas)
TELEGRAM_POLLING=true

# Admin autentifikatsiya (JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS — frontend manzili (vergul bilan ajratilgan ro'yxat)
CORS_ORIGINS=http://localhost:3000

# Log darajasi: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
